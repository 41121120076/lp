}


/* =========================================================
   GOLD LIGHT SWEEP
========================================================= */

.footer-btn-jhncorps::after {
    content: "";

    position: absolute;

    top: 0;
    left: -110%;

    width: 55%;
    height: 100%;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(242,210,124,.12),
            transparent
        );

    transform: skewX(-20deg);

    transition:
        left .55s ease;

    pointer-events: none;
