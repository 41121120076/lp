/* =========================================================
   FLOATING GLASS NAVIGATION
   MATCH PRODUCT / ARTICLE / FOOTER SECTION
========================================================= */

.footer-floating-ASUPANTOTO {
    position: fixed;

    left: 50%;
    bottom: 18px;

    z-index: 9999;

    width: min(1120px, calc(100% - 30px));

    transform: translateX(-50%);

    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));

    gap: 10px;

    padding: 12px;

    box-sizing: border-box;

    /* SAME DARK NAVY BACKGROUND */
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.085),
            rgba(255,255,255,.025)
        ),
        rgba(7,17,31,.92);

    /* GLASS BORDER */
    border: 1px solid rgba(242,210,124,.25);

    border-radius: 22px;

    /* PREMIUM GLASS SHADOW */
    box-shadow:
        0 20px 55px rgba(0,0,0,.45),
        0 0 25px rgba(242,210,124,.06),
        inset 0 1px 0 rgba(255,255,255,.16),
        inset 0 -5px 15px rgba(0,0,0,.12);

    /* BLUR ONLY ON THE MAIN CONTAINER */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    animation:
        footerFloatIn .55s ease both;
}


/* =========================================================
   GLASS REFLECTION
========================================================= */

.footer-floating-ASUPANTOTO::before {
    content: "";

    position: absolute;

    top: 1px;
    left: 7%;

    width: 86%;
    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.32),
            rgba(242,210,124,.28),
            rgba(255,255,255,.32),
            transparent
        );

    pointer-events: none;
}


/* =========================================================
   GOLD AMBIENT LIGHT
========================================================= */

.footer-floating-ASUPANTOTO::after {
    content: "";

    position: absolute;

    left: 20%;
    right: 20%;
    bottom: -15px;

    height: 25px;

    border-radius: 50%;

    background:
        radial-gradient(
            ellipse,
            rgba(242,210,124,.13),
            transparent 70%
        );

    filter: blur(8px);

    pointer-events: none;
}


/* =========================================================
   BUTTON BASE
========================================================= */

.footer-btn-jhncorps {
    position: relative;

    min-width: 0;
    min-height: 58px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 12px;

    box-sizing: border-box;

    overflow: hidden;

    color: rgba(255,255,255,.9);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.105),
            rgba(255,255,255,.025)
        );

    border:
        1px solid rgba(255,255,255,.12);

    border-radius: 15px;

    box-shadow:
        5px 5px 14px rgba(0,0,0,.22),
        inset 1px 1px 2px rgba(255,255,255,.12),
        inset 0 -3px 8px rgba(0,0,0,.08);

