<script>
const circle = document.getElementById("gameCircle");
const cards = [...document.querySelectorAll(".game-card")];
const total = cards.length;
const radius = 380;
let rotateY = 0;

cards.forEach((card, index) => {
    const angle = (360 / total) * index;
    card.style.transform = `rotateY(${angle}deg) translateZ(${radius}px)`;
});

function render() {
    circle.style.transform = `rotateX(-10deg) rotateY(${rotateY}deg)`;
}

render();

let auto = setInterval(() => {
    rotateY -= 0.35;
    render();
}, 30);

let dragging = false;
let startX = 0;

circle.addEventListener("mousedown", (e) => {
    dragging = true;
    startX = e.clientX;
    clearInterval(auto);
});

window.addEventListener("mouseup", () => {
    if (!dragging) return;
    dragging = false;
    auto = setInterval(() => {
        rotateY -= 0.35;
        render();
    }, 30);
});

window.addEventListener("mousemove", (e) => {
    if (!dragging) return;
    rotateY += (e.clientX - startX) * 0.4;
    startX = e.clientX;
    render();
});

circle.addEventListener("touchstart", (e) => {
    dragging = true;
    startX = e.touches[0].clientX;
    clearInterval(auto);
});

window.addEventListener("touchend", () => {
    if (!dragging) return;
    dragging = false;
    auto = setInterval(() => {
        rotateY -= 0.35;
        render();
    }, 30);
});

window.addEventListener("touchmove", (e) => {
    if (!dragging) return;
    rotateY += (e.touches[0].clientX - startX) * 0.45;
    startX = e.touches[0].clientX;
    render();
});
</script>

